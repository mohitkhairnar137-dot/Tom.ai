{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tom-ai-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "TOM_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
